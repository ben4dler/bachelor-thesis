# IDEs and editors
.idea/
*.iml
.vscode/
*~
*.swp
# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example
# Jupyter
.ipynb_checkpoints/
